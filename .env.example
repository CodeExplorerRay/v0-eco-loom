# Neon + Prisma
# Use the pooled Neon URL for runtime queries.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Use the direct Neon URL for Prisma CLI work.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Eco-Loom auth and secrets
ECO_LOOM_AUTH_SECRET="replace-with-a-long-random-secret"
ECO_LOOM_ENCRYPTION_KEY="replace-with-a-long-random-encryption-key"
ECO_LOOM_API_TOKEN="replace-with-a-long-random-admin-token"
ECO_LOOM_STANDARD_USER_TOKEN="replace-with-a-long-random-standard-token"
ECO_LOOM_ALLOWED_COMPANY_ID="demo-company-1"
ECO_LOOM_COMPANY_NAME="Eco-Loom Workspace"

# Optional identity labels
ECO_LOOM_ADMIN_EMAIL="admin@eco-loom.local"
ECO_LOOM_ADMIN_NAME="Eco-Loom Admin"
ECO_LOOM_STANDARD_USER_EMAIL="analyst@eco-loom.local"
ECO_LOOM_STANDARD_USER_NAME="Sustainability Analyst"

# Session and cron
ECO_LOOM_SESSION_TTL_SECONDS="28800"
CRON_SECRET="replace-with-a-long-random-cron-secret"
AGENT_TASKS_CRON_LIMIT="25"
# Legacy alias still accepted by the app for manual calls, but Vercel Cron authorization
# is only attached automatically when the deployed project has CRON_SECRET configured.
AGENT_TASKS_CRON_SECRET=""

# Keep disabled in shared environments and production
ECO_LOOM_ENABLE_DEV_BOOTSTRAP="false"
